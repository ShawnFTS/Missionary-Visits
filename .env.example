# Copy these into Railway > your service > Variables. Nothing here is a secret until you fill it in.
DATA_DIR=/data                       # must match the Railway volume mount path
SELF_URL=https://your-app.up.railway.app
ADMIN_PASSWORD=choose-something-long
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
TWILIO_FROM=+18445550123             # your Twilio number, with +1
